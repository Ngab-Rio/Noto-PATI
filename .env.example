# ==============================================================================
# Noto PATI — Environment Variables Example
# Salin berkas ini ke `.env.local` dan isi nilainya sesuai lingkungan Anda.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Frontend / Client Variables (Wajib berawalan NEXT_PUBLIC_)
# ------------------------------------------------------------------------------
# URL basis aplikasi (diperlukan untuk auth callback, canonical URL, metadata)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Kredensial publik Supabase (dari Dashboard Supabase -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Fitur pembantu pengujian/demo (opsional: "true" atau "false")
# Mengizinkan simulasi koordinat Kabupaten Pati saat pengujian di luar wilayah
NEXT_PUBLIC_ENABLE_MOCK_LOCATION=false

# ------------------------------------------------------------------------------
# 2. Server-Only Variables (RAHASIA: Jangan pernah diawali NEXT_PUBLIC_)
# ------------------------------------------------------------------------------
# Kunci service role Supabase (hanya digunakan untuk skrip operasional admin)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Kunci otentikasi cron job internal (/api/cron/cleanup-drafts)
CRON_SECRET=your-internal-cron-secret